{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tofas-2026",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "account_id": "8a84ca413d7ce03eae26bec08da84d67",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "tofas", "database_id": "ee2fac7b-4ed6-462b-acdc-67d25db0aee2", "migrations_dir": "migrations" }],
  "vars": {
    "AUTH_PROVIDER": "google",
    "GOOGLE_CLIENT_ID": "690960078159-91f75dmbe15adpu7c0ir519v2023ib57.apps.googleusercontent.com",
    "DOCUMENT_DELIVERY": "drive",
    "RELEASE_APPROVED": "false",
    "ACCESS_ISSUER": "https://configure-your-team.cloudflareaccess.com",
    "ACCESS_AUD": "configure-application-audience",
    "PRIVACY_CONTACT": "",
    "DATASET": "synthetic"
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": false }
}
